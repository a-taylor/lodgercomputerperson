// The /api/intent Worker (worker/index.ts). Run it locally with `npm run dev:worker`, deploy it with
// `npm run deploy:worker`; see docs/llm.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lodgercomputerperson-intent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Serve it at <name>.<account subdomain>.workers.dev.
  "workers_dev": true,
  // At most 10 requests a minute. namespace_id is any number unique within the account.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // Logs from deployed requests, viewable in the dashboard.
  "observability": { "enabled": true }
}
