// The Worker for /api/intent and /api/letter (worker/index.ts). Run it locally with
// `npm run dev:worker`, deploy it with `npm run deploy:worker`; see docs/llm.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lodgercomputerperson-intent",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Serve it at <name>.<account subdomain>.workers.dev.
  "workers_dev": true,
  // About 10 requests a minute (Cloudflare's limiter is approximate). namespace_id is any number
  // unique within the account.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // The hard daily cap (worker/counter.ts): a SQLite-backed Durable Object counting requests per UTC
  // day. Try a low limit locally with `npm run dev:worker -- --var DAILY_LIMIT:3`.
  "vars": { "DAILY_LIMIT": 300 },
  "durable_objects": { "bindings": [{ "name": "DAILY", "class_name": "DailyCounter" }] },
  // Tells Cloudflare to create the class's storage. Each new class or change gets a new tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyCounter"] }],
  // Logs from deployed requests, viewable in the dashboard.
  "observability": { "enabled": true }
}
